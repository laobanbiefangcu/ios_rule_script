#!name=Google搜索重定向（Surge 修正版）
#!desc=google.cn→google.com；generate_204 本地回 204，避免安卓 Captive Portal 误判

[Map Local]
^https?:\/\/www\.google\.cn\/generate_204 data-type=text data="" status-code=204

[URL Rewrite]
^https?:\/\/(www\.)?(g|google)\.cn\/(?!generate_204) https://www.google.com 307
^https?:\/\/(ditu|maps)\.google\.cn https://maps.google.com 307

[MITM]
hostname = %APPEND% www.google.cn, maps.google.cn
